# Copia este archivo como .env y llena tus valores. El archivo .env NO se sube a GitHub.

# Amazon RDS (práctica 2.4)
DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=escribe_aqui_tu_contraseña
DB_NAME=vehiculo_iot

# Clave para operaciones de control y eliminación (encabezado X-API-Key)
API_KEY=cambia_esta_clave

# Origen que se guarda en historial_comandos
ORIGEN_MOVIMIENTO=API-LOCAL

# Servidor local
HOST=127.0.0.1
PORT=8000
